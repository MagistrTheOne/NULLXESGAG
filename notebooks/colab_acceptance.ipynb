{
 "cells": [
  {"cell_type":"markdown","metadata":{},"source":["# NULLXES GAG CAP VC — Phase 02.5 Colab acceptance\n","\n","Запускать только в размещённом Google Colab CPU runtime. Local runtime запрещён. Пустые данные, отсутствующий API ключ, модель или документ дают SKIPPED/FAIL, никаких демонстрационных данных и предварительных PASS. Все сетевые и модельные действия происходят только при запуске соответствующих ячеек."]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import os, platform, json, traceback\n","from pathlib import Path\n","RESULTS = {}\n","def step(name, fn):\n","    try:\n","        detail = fn()\n","        RESULTS[name] = {'status':'PASS','diagnostic':str(detail)}\n","    except SkipStep as exc:\n","        RESULTS[name] = {'status':'SKIPPED','diagnostic':str(exc)}\n","    except Exception as exc:\n","        RESULTS[name] = {'status':'FAIL','diagnostic':f'{type(exc).__name__}: {exc}'}\n","    print(name, RESULTS[name])\n","class SkipStep(Exception): pass\n","def require_colab_cpu():\n","    if 'COLAB_RELEASE_TAG' not in os.environ: raise RuntimeError('Hosted Google Colab runtime required; local runtime is prohibited')\n","    if Path('/dev/nvidia0').exists(): raise RuntimeError('GPU detected; switch to CPU runtime')\n","    return f'hosted Colab CPU; Python {platform.python_version()}; cores={os.cpu_count()}'\n","step('01_cpu_hosted_runtime', require_colab_cpu)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def mount_drive():\n","    if RESULTS['01_cpu_hosted_runtime']['status'] != 'PASS': raise SkipStep('Hosted CPU gate failed')\n","    from google.colab import drive\n","    drive.mount('/content/drive')  # Google Colab asks for the user's explicit authorization\n","    return 'Drive mounted after interactive Colab authorization'\n","step('02_drive_mount', mount_drive)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Dependency installation occurs only in hosted Colab after step 01 passes. Pytest is never installed here.\n","import subprocess, sys\n","PROJECT = Path('/content/drive/MyDrive/NULLXES/GAG-CAP-VC/project')\n","def install_project():\n","    if RESULTS['01_cpu_hosted_runtime']['status'] != 'PASS': raise SkipStep('Hosted CPU gate failed')\n","    if not (PROJECT / 'pyproject.toml').is_file(): raise SkipStep('Copy reviewed project folder to Drive path shown in PROJECT')\n","    os.chdir(PROJECT)\n","    result=subprocess.run([sys.executable,'-m','pip','install','-e','.[terminal,calibration]'],capture_output=True,text=True)\n","    if result.returncode: raise RuntimeError((result.stdout+'\\n'+result.stderr)[-5000:])\n","    return result.stdout[-2000:]\n","step('03_colab_dependencies', install_project)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["PROJECT = Path('/content/drive/MyDrive/NULLXES/GAG-CAP-VC/project')\n","def import_project():\n","    if not (PROJECT / 'pyproject.toml').is_file(): raise SkipStep('Copy reviewed project folder to Drive path shown in PROJECT; no implicit download')\n","    os.chdir(PROJECT)\n","    return __import__('gagcap').__file__\n","step('04_project_import', import_project)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def run_unit_tests():\n","    if __import__('importlib.util',fromlist=['find_spec']).find_spec('pytest') is None: raise SkipStep('Pytest is not installed and this notebook will not install it')\n","    result = subprocess.run([sys.executable,'-m','pytest','-q','-m','not integration'],capture_output=True,text=True)\n","    if result.returncode: raise RuntimeError((result.stdout+'\\n'+result.stderr)[-6000:])\n","    return result.stdout[-3000:]\n","step('05_unit_tests', run_unit_tests)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Provider reachability checks use official endpoints and do not print FRED credentials.\n","import requests\n","def api_checks():\n","    checks = {}\n","    try:\n","        from datetime import date\n","        from gagcap.ingestion.cbr import key_rate\n","        checks['CBR'] = f'key_rate rows={len(key_rate(date(2025,1,1),date(2025,1,31)))}'\n","    except Exception as e: checks['CBR'] = f'{type(e).__name__}: {e}'\n","    try:\n","        r=requests.get('https://iss.moex.com/iss/engines/stock/markets/shares/boards/TQBR/securities/SBER/candles.json',params={'from':'2025-01-01','till':'2025-01-31','interval':'24','limit':'1'},timeout=20); r.raise_for_status(); checks['MOEX']=f'HTTP {r.status_code}'\n","    except Exception as e: checks['MOEX']=f'{type(e).__name__}: {e}'\n","    try:\n","        from google.colab import userdata\n","        key=userdata.get('FRED_API_KEY')\n","        if not key: checks['FRED']='SKIPPED: FRED_API_KEY missing in Colab Secrets'\n","        else:\n","            r=requests.get('https://api.stlouisfed.org/fred/series/observations',params={'series_id':'CPIAUCSL','api_key':key,'file_type':'json','limit':'1'},timeout=20); r.raise_for_status(); checks['FRED']=f'HTTP {r.status_code}'\n","    except Exception as e: checks['FRED']=f'{type(e).__name__}: FRED credential detail redacted'\n","    if not checks['CBR'].startswith('key_rate rows=') or not checks['MOEX'].startswith('HTTP 2'):\n","        raise RuntimeError(f'CBR/MOEX API check failed: {checks}')\n","    return checks\n","step('06_api_reachability', api_checks)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["from datetime import date\n","def ingest_real_series():\n","    from gagcap.ingestion.cbr import key_rate\n","    from gagcap.ingestion.moex import candles\n","    from gagcap.ingestion.fred import observations\n","    from gagcap.storage.lake import ObservationLake\n","    from google.colab import userdata\n","    root=Path('/content/drive/MyDrive/NULLXES/GAG-CAP-VC/acceptance')\n","    lake=ObservationLake(root/'lake')\n","    start,end=date(2023,1,1),date.today()\n","    loaded=[]; issues={}\n","    for name,fetch in [('CBR',lambda:key_rate(start,end)),('MOEX_SBER',lambda:candles('SBER',start,end,unit='RUB_per_share'))]:\n","        try: batch=fetch(); lake.write(batch); loaded.extend(batch); issues[name]=len(batch)\n","        except Exception as e: issues[name]=f'DATA_UNAVAILABLE {type(e).__name__}: {e}'\n","    api_key=userdata.get('FRED_API_KEY')\n","    if api_key:\n","        os.environ['FRED_API_KEY']=api_key\n","        try: batch=observations('CPIAUCSL',start,end,unit='index_1982_84_100'); lake.write(batch); loaded.extend(batch); issues['FRED_CPIAUCSL']=len(batch)\n","        except Exception as e: issues['FRED_CPIAUCSL']=f'DATA_UNAVAILABLE {type(e).__name__}: {e}'\n","    else: issues['FRED_CPIAUCSL']='SKIPPED: secret not configured'\n","    if not any(x.source=='moex' and x.value is not None for x in loaded): raise RuntimeError(f'Required real market data unavailable: {issues}')\n","    if not any(x.source in {'cbr','fred'} and x.value is not None for x in loaded): raise RuntimeError(f'Required real macro data unavailable: {issues}')\n","    globals()['LAKE']=lake; globals()['LAKE_PATH']=root/'lake'; globals()['INGEST_STATUS']=issues\n","    return issues\n","step('07_real_data_ingestion', ingest_real_series)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def validate_store():\n","    if 'LAKE' not in globals(): raise SkipStep('Ingestion did not provide a real dataset')\n","    df=LAKE.query('SELECT source, count(*) AS n FROM observations GROUP BY source ORDER BY source')\n","    if df.empty: raise RuntimeError('Parquet/DuckDB returned no records')\n","    return df.to_dict(orient='records')\n","step('08_parquet_duckdb', validate_store)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def multi_horizon_backtest():\n","    if 'LAKE' not in globals(): raise SkipStep('No real ingested market series')\n","    import pandas as pd\n","    from gagcap.forecasting.backtesting import walk_forward_calendar_horizon\n","    from gagcap.forecasting.baselines import random_walk\n","    data=LAKE.query(\"SELECT observation_date,value FROM observations WHERE source='moex' AND value IS NOT NULL ORDER BY observation_date\")\n","    if data.empty: raise SkipStep('MOEX observations unavailable')\n","    idx=pd.DatetimeIndex(pd.to_datetime(data.observation_date,utc=True)); series=pd.Series(data.value.astype(float).to_numpy(),index=idx)\n","    records=[]; summary={}\n","    for days in (7,30,90):\n","        rows=walk_forward_calendar_horizon(series,calendar_days=days,min_train=252,predictor=lambda train,h:random_walk(float(train.iloc[-1]),h))\n","        if not rows: summary[str(days)]='SKIPPED: insufficient training or outcome history'; continue\n","        records.extend(rows); summary[str(days)]={'calendar_days':days,'n':len(rows),'session_steps_min':min(r.horizon_steps for r in rows),'session_steps_max':max(r.horizon_steps for r in rows)}\n","    if not records: raise RuntimeError(f'No evaluable 7/30/90 forecasts: {summary}')\n","    globals()['BACKTEST_RECORDS']=records\n","    return summary\n","step('09_backtest_7_30_90', multi_horizon_backtest)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def load_alfred_vintages():\n","    from gagcap.ingestion.fred import historical_vintages\n","    from google.colab import userdata\n","    key=userdata.get('FRED_API_KEY')\n","    if not key: raise SkipStep('FRED_API_KEY not set in Colab Secrets')\n","    os.environ['FRED_API_KEY']=key\n","    rows=historical_vintages('CPIAUCSL',date(2020,1,1),date.today(),unit='index_1982_84_100',max_requests=12,max_vintages=5,minimum_interval_seconds=0.5)\n","    if not rows: raise RuntimeError('ALFRED returned no vintages')\n","    globals()['ALFRED_ROWS']=rows\n","    return f'{len(rows)} observations across {len({r.vintage_date for r in rows})} vintages'\n","step('10_alfred_vintage', load_alfred_vintages)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def qwen_cpu_inference():\n","    model=os.environ.get('QWEN_GGUF_PATH')\n","    source=os.environ.get('GEO_SOURCE_TEXT','')\n","    url=os.environ.get('GEO_SOURCE_URL','')\n","    if not model or not Path(model).is_file(): raise SkipStep('QWEN_GGUF_PATH missing; download official model in this Colab session before this step')\n","    if not source.strip() or not url.startswith('https://'): raise SkipStep('Provide reviewed source text and its exact HTTPS document URL')\n","    from gagcap.intelligence.qwen import extract_event\n","    result=extract_event(source,source_url=url,model_path=model,cpu_threads=os.cpu_count(),context_size=4096)\n","    if result.status!='AVAILABLE' or result.event is None: raise RuntimeError(f'{result.status}: {result.reason}')\n","    globals()['QWEN_RESULT']=result\n","    return {'status':result.status,'event_status':result.event.event_status,'calibration':'UNCALIBRATED'}\n","step('11_qwen_cpu_json', qwen_cpu_inference)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def geo_risk_point_in_time():\n","    if 'QWEN_RESULT' not in globals(): raise SkipStep('Qwen extraction unavailable; no event fabricated')\n","    from datetime import datetime, timezone\n","    from gagcap.intelligence.geo_risk import GeoEvent, events_available_at_origin\n","    q=QWEN_RESULT.event\n","    if q.published_at is None: raise SkipStep('Source has no verifiable publication timestamp')\n","    published=datetime.fromisoformat(q.published_at.replace('Z','+00:00'))\n","    event=GeoEvent('qwen-extracted',q.event_type,q.source_url,published,\n","                   date.fromisoformat(q.event_date) if q.event_date else published.date(),\n","                   tuple(q.countries),tuple(q.sectors),tuple(q.assets),\n","                   ' '.join(q.evidence_quotes),'Qwen3-0.6B-GGUF',q.event_status,False)\n","    origin=datetime.now(timezone.utc)\n","    selected=events_available_at_origin([event],origin)\n","    return {'eligible_events':len(selected),'event_status':event.status,'LLM_confidence_is_probability':False}\n","step('12_geo_risk_extraction', geo_risk_point_in_time)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def save_results():\n","    root=Path('/content/drive/MyDrive/NULLXES/GAG-CAP-VC/acceptance'); root.mkdir(parents=True,exist_ok=True)\n","    serializable={k:v for k,v in RESULTS.items()}\n","    (root/'phase-02-5-run-status.json').write_text(json.dumps(serializable,ensure_ascii=False,indent=2),encoding='utf-8')\n","    if 'BACKTEST_RECORDS' in globals():\n","        import pandas as pd\n","        pd.DataFrame([r.__dict__ if hasattr(r,'__dict__') else {name:getattr(r,name) for name in r.__dataclass_fields__} for r in BACKTEST_RECORDS]).to_parquet(root/'backtest.parquet',index=False)\n","    return str(root)\n","step('13_save_results', save_results)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def acceptance_report():\n","    root=Path('/content/drive/MyDrive/NULLXES/GAG-CAP-VC/acceptance'); root.mkdir(parents=True,exist_ok=True)\n","    text='# NULLXES GAG CAP VC — Colab acceptance report\\n\\n'\n","    text+='Generated from this execution only. ACCEPTED requires every required gate PASS and independent review.\\n\\n'\n","    for name,item in RESULTS.items(): text += '- **{}** `{}` — {}\\n'.format(item['status'],name,item['diagnostic'])\n","    all_pass=bool(RESULTS) and all(item['status']=='PASS' for item in RESULTS.values())\n","    text += '\\nFinal status: ' + ('READY_FOR_REVIEW' if all_pass else 'UNVERIFIED') + '\\n'\n","    path=root/'acceptance-report.md'; path.write_text(text,encoding='utf-8'); print(text); return str(path)\n","step('14_acceptance_report', acceptance_report)"]},
